# Endpoint privé compatible avec POST /v1/chat/completions.
MEDICAL_MODEL_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
MEDICAL_MODEL_NAME=helix-medical

# Facultatif si la passerelle d’inférence impose une authentification interne.
MEDICAL_MODEL_API_KEY=

MEDICAL_MODEL_TIMEOUT_MS=45000
MEDICAL_MODEL_MAX_RETRIES=1

# Identité affichée dans les comptes rendus. Ces données sont publiques dans le document final.
NEXT_PUBLIC_PRACTITIONER_NAME=Médecin responsable
NEXT_PUBLIC_PRACTITIONER_SPECIALTY=Médecine générale
NEXT_PUBLIC_PRACTITIONER_INPE=
NEXT_PUBLIC_FACILITY_NAME=Établissement de santé
NEXT_PUBLIC_FACILITY_ADDRESS=
NEXT_PUBLIC_FACILITY_CITY=
NEXT_PUBLIC_FACILITY_PHONE=
NEXT_PUBLIC_FACILITY_FAX=
NEXT_PUBLIC_FACILITY_EMAIL=
